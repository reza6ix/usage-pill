{
  "manifest_version": 3,
  "name": "Usage Pill for Claude",
  "short_name": "Usage Pill",
  "version": "1.1.0",
  "description": "A tiny always-on pill that shows your Claude usage and how long until it resets. Unofficial.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "http://127.0.0.1:47823/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Claude usage",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared.js",
        "pill.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-pill": {
      "suggested_key": {
        "default": "Alt+Shift+U",
        "mac": "Alt+Shift+U"
      },
      "description": "Show / hide the floating usage pill"
    }
  }
}
